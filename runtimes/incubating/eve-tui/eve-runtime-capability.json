      "evidencePaths": [
        "runtimes/incubating/eve-tui/package.json",
        "runtimes/incubating/eve-tui/src/eve-tui-shell.mjs",
        "runtimes/incubating/eve-tui/test/eve-tui-shell.test.mjs",
        "runtimes/incubating/eve-tui/evetui-split-handoff.json",
        "scripts/run-evetui-split-handoff-smoke.ps1",
        "scripts/run-evetui-provider-shell-smoke.ps1"
