<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>The gamecult.thing.* wire types, held to the Rust crate's goldens.</Description>
    <PackageId>GameCult.Thing.Contract</PackageId>
    <Version>0.1.0</Version>
    <Authors>GameCult</Authors>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/GameCult/Eve</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GameCult/Eve</RepositoryUrl>
    <BaseOutputPath>obj\bin\</BaseOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CultLibRoot Condition="'$(CultLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\CultLib</CultLibRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CultLibRoot)\src\GameCult.Caching\GameCult.Caching.csproj" />
  </ItemGroup>
</Project>
