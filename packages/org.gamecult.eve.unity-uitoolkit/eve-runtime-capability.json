{
  "schema": "gamecult.eve.runtime_capability.v1",
  "runtimeId": "unity-uitoolkit",
  "title": "Unity / UI Toolkit",
  "owner": "EveUnity",
  "incubation": {
    "ownerRepo": "EveUnity",
    "currentHostRepo": "Eve",
    "splitTarget": "EveUnity",
    "graduationTrigger": "Split when Unity package has independent UPM release, plugin host behavior, and Unity test/capture lifecycle."
  },
  "supportedFeatures": [
    "embeddedDocuments"
  ],
  "supportedPlugins": [
    {
      "pluginId": "sai.vn",
      "capabilities": [
        "vn.stage",
        "story.choose",
        "story.continue",
        "story.jump"
      ],
      "host": "SaiVisualNovelUiToolkitPluginHost"
    },
    {
      "pluginId": "norn.graph",
      "capabilities": [
        "embed.norn"
      ],
      "host": "NornGraphUiToolkitPluginHost"
    }
  ],
  "unsupportedPlugins": [
    {
      "pluginId": "tex.math",
      "reason": "Unity UI Toolkit currently preserves embed.tex as generic Eve structure; no TeX render plugin host exists in this runtime."
    }
  ],
  "commandTransport": {
    "schema": "gamecult.eve.command.v1",
    "emitter": "EveUiToolkitSurfaceLowerer.EmitCommand",
    "clientId": "unity-uitoolkit"
  },
  "capture": {
    "status": "semantic",
    "note": "Unity UI Toolkit lowers embedded document slots through a resolver-backed child surface host."
  }
}
