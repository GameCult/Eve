      "evidencePaths": [
        "packages/org.gamecult.eve.unity-uitoolkit/package.json",
        "packages/org.gamecult.eve.unity-uitoolkit/README.md",
        "scripts/run-aetheria-unity-package-smoke.ps1"
      ],
      "pendingProofs": [
        "Tagged UPM release cut from EveUnity rather than Eve incubation."
