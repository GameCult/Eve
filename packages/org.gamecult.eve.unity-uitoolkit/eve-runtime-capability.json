    "test": {
      "ownerRepo": "EveUnity",
      "status": "consumer-build-smoke",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-aetheria-unity-package-smoke.ps1",
      "evidencePaths": [
        "scripts/run-aetheria-unity-package-smoke.ps1"
      ],
      "pendingProofs": [
        "Unity EditMode or PlayMode test assembly runs from the runtime repo."
      ]
    },
    "capture": {
      "ownerRepo": "EveUnity",
      "status": "pending-editor-capture",
      "evidencePaths": [],
