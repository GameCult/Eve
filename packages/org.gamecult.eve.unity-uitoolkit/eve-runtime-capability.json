        "vn.stage",
        "story.choose",
        "story.continue",
        "story.jump"
      ],
      "host": "SaiVisualNovelUiToolkitPluginHost"
    },
    {
      "pluginId": "norn.graph",
      "capabilities": [
        "embed.norn"
      ],
      "host": "NornGraphUiToolkitPluginHost"
    }
  ],
  "unsupportedPlugins": [
    {
      "pluginId": "tex.math",
      "reason": "Unity UI Toolkit currently preserves embed.tex as generic Eve structure; no TeX render plugin host exists in this runtime."
    }
  ],
  "commandTransport": {
    "schema": "gamecult.eve.command.v1",
