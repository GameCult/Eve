{
  "schema": "gamecult.eve.plugin_advertisement.v1",
  "pluginId": "sai.vn",
  "ownerService": "sai",
  "version": "0.1.0-incubating",
  "manifestAddress": "file://plugins/incubating/sai-vn.plugin.json",
  "runtime": {
    "invocationModel": "executable-sidecar",
    "contract": "gamecult.eve.plugin_abi.v1",
    "transports": ["cultmesh", "stdio"],
    "authority": [
      "renderer-independent",
      "no-provider-state-mutation",
      "provider-accepts-or-denies-commands"
    ],
    "sidecar": {
      "processKind": "long-running-daemon",
      "protocol": "cultmesh-rpc-with-stdio-dev-transport",
      "requestSchema": "gamecult.eve.plugin_abi.request.v1",
      "responseSchema": "gamecult.eve.plugin_abi.response.v1",
      "operations": ["describe", "validate", "project", "lower", "measure", "apply"],
      "commandEnvelope": "gamecult.eve.command_invocation.v1",
      "receiptSchema": "gamecult.eve.command_receipt.v1",
      "stateAuthority": "proposes-plugin-state-only-provider-accepts"
    }
  },
  "schemas": [
    "sai.vn.story_session.v1",
    "sai.vn.visual_manifest.v1"
  ],
  "componentKinds": [
    "vn.stage",
    "panel.dialogue",
    "text.dialogue",
    "rail.actions"
  ],
  "commands": [
    "story.continue",
    "story.choose",
    "story.jump"
  ],
  "fixtures": [
    "sai-vn"
  ]
}
