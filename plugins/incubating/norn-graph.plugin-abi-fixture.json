      "expect": {
        "measurementKind": "graph-layout-metrics",
        "measurementOutputs": ["nodeBounds", "edgeRoutes", "viewportBounds"],
        "preservesProviderAuthority": true
      }
    },
    {
      "operation": "apply",
      "input": {
        "commands": ["graph.node.activate", "graph.focus"]
      },
      "expect": {
