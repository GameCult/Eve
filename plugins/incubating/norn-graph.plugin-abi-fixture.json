        "rejectedComponentKinds": ["embed.tex", "vn.stage"],
        "requiredCapabilities": ["embed.norn"]
      }
    },
    {
      "operation": "project",
      "input": {
        "surface": "web/fixtures/sai-vn-surface.json",
        "nodeKind": "embed.norn"
      },
      "expect": {
        "projectionKind": "embedded-semantic-surface",
        "ownedComponentKinds": ["embed.norn"],
        "outputSchemas": ["norn.graph.document.v1", "norn.graph.layout_request.v1", "norn.graph.layout_result.v1"]
      }
    },
    {
      "operation": "lower",
