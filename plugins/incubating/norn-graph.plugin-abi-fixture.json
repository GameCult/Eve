{
  "schema": "gamecult.eve.plugin_abi_fixture.v1",
  "fixtureId": "norn-graph-plugin-abi",
  "pluginId": "norn.graph",
  "ownerRepo": "Norn",
  "contract": "gamecult.eve.plugin_abi.v1",
  "sourceFixture": "sai-vn",
  "operations": [
    {
      "operation": "describe",
      "input": {
        "manifest": "plugins/incubating/norn-graph.plugin.json",
        "advertisement": "plugins/incubating/norn-graph.plugin-advertisement.json"
      },
      "expect": {
        "pluginId": "norn.graph",
        "componentKinds": ["embed.norn"],
        "commands": ["graph.node.activate", "graph.focus"],
        "capabilities": ["embed.norn", "graph.node.activate"]
      }
    },
    {
