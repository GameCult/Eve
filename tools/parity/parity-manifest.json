{
  "schema": "gamecult.eve.parity_manifest.v1",
  "repoStrategy": {
    "boundaryRule": "Eve core owns contracts; plugins own semantics; runtime repos own native projection; provider repos own live truth.",
    "incubationPolicy": "Eve may host runtimes, plugins, and conformance packs only while their contract is still forming.",
    "graduationDocument": "docs/repo-strategy.md"
  },
  "schemas": {
    "gamecult.eve.conformance_fixture.v1": "schemas/gamecult.eve.conformance_fixture.v1.schema.json",
    "gamecult.eve.conformance_export.v1": "schemas/gamecult.eve.conformance_export.v1.schema.json",
    "gamecult.eve.command.v1": "schemas/gamecult.eve.command.v1.schema.json",
    "gamecult.eve.plugin.v1": "schemas/gamecult.eve.plugin.v1.schema.json",
    "gamecult.eve.plugin_abi_fixture.v1": "schemas/gamecult.eve.plugin_abi_fixture.v1.schema.json",
    "gamecult.eve.plugin_advertisement.v1": "schemas/gamecult.eve.plugin_advertisement.v1.schema.json",
    "gamecult.eve.runtime_capability.v1": "schemas/gamecult.eve.runtime_capability.v1.schema.json",
    "gamecult.eve.provider_scenario.v1": "schemas/gamecult.eve.provider_scenario.v1.schema.json",
    "gamecult.eve.provider_advertisement.v1": "schemas/gamecult.eve.provider_advertisement.v1.schema.json"
  },
  "conformancePacks": [
    {
      "id": "core",
      "ownerRepo": "Eve",
      "exitCriteria": "Stays in Eve; proves surface contract, CultUI DSL, bindings, commands, and embedded documents."
    },
    {
      "id": "plugin",
      "ownerRepo": "EvePlugins until owner repos stabilize",
      "exitCriteria": "Moves when plugin semantics, fixtures, and conformance cases are stable."
    },
    {
      "id": "provider",
      "ownerRepo": "Provider repo",
      "exitCriteria": "Moves when fixture carries product-specific state, assets, flows, or receipts."
    },
    {
      "id": "runtime",
      "ownerRepo": "Runtime repo",
      "exitCriteria": "Moves when runtime has its own build/deploy lifecycle or platform SDK pressure."
    }
  ],
  "responsiveCases": [
    {
      "id": "phone",
      "width": 390,
      "height": 844,
      "orientation": "portrait",
      "deviceScale": 1
    },
    {
      "id": "tablet",
      "width": 768,
      "height": 1024,
      "orientation": "portrait",
      "deviceScale": 1
    },
    {
      "id": "desktop",
      "width": 1280,
      "height": 720,
      "orientation": "landscape",
      "deviceScale": 1
    }
  ],
  "androidDeviceCases": [
    {
      "id": "native-portrait",
      "orientation": "portrait"
    },
    {
      "id": "native-landscape",
      "orientation": "landscape"
    }
  ],
