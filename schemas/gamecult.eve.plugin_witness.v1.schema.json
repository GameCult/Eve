{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamecult.eve.plugin_witness.v1",
  "title": "Eve Plugin Sidecar Witness",
  "type": "object",
  "required": ["schema", "witnessId", "pluginId", "ownerRepo", "status", "transport", "generatedAtUtc", "durationMs", "operations", "authority"],
  "properties": {
    "schema": { "const": "gamecult.eve.plugin_witness.v1" },
    "witnessId": { "type": "string", "minLength": 1 },
    "pluginId": { "type": "string", "minLength": 1 },
    "ownerRepo": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail"] },
    "transport": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": "string", "minLength": 1 },
    "durationMs": { "type": "number", "minimum": 0 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "requestId", "status", "durationMs", "expectationCount"],
        "properties": {
          "operation": { "type": "string", "minLength": 1 },
          "requestId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "durationMs": { "type": "number", "minimum": 0 },
          "expectationCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "authority": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
