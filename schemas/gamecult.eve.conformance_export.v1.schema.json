{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamecult.eve.conformance_export.v1",
  "title": "Eve Conformance Export",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "sourceManifest",
    "packs",
    "plugins",
    "providers",
    "runtimes",
    "splitTargets"
  ],
  "properties": {
    "schema": {
      "const": "gamecult.eve.conformance_export.v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceManifest": {
      "type": "string",
      "minLength": 1
    },
    "boundaryRule": {
      "type": "string"
    },
    "incubationPolicy": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fixtures"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string"
          },
          "exitCriteria": {
            "type": "string"
          },
          "fixtures": {
            "type": "array"
          },
          "runtimeTargets": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "capabilityMatrix": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gamecult.eve.capability_matrix.v1"
        }
      },
      "additionalProperties": true
    },
    "capabilityGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "subjectId", "gap", "severity"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "worldSurfaceLoweringGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "providerId",
          "surfaceId",
          "targetId",
          "ownerRepo",
          "runtimeId",
          "severity"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "providerOwnerRepo": {
            "type": "string"
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1
          },
          "surfaceKind": {
            "type": "string"
          },
          "projectionKind": {
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string",
            "minLength": 1
          },
          "runtimeId": {
            "type": "string",
            "minLength": 1
          },
          "splitTarget": {
            "type": "string"
          },
          "runtimeStatus": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pluginId",
          "status",
          "ownerRepo",
          "splitTarget",
          "manifestPath",
          "advertisementPath",
          "abiFixturePath",
          "capabilities"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string",
            "minLength": 1
          },
          "splitTarget": {
            "type": "string",
            "minLength": 1
          },
          "manifestPath": {
            "type": "string",
            "minLength": 1
          },
          "advertisementPath": {
            "type": "string",
            "minLength": 1
          },
          "handoffPath": {
            "type": "string"
          },
          "handoffExportPath": {
            "type": "string"
          },
          "abiFixturePath": {
            "type": "string",
            "minLength": 1
          },
          "abiOperations": {
            "type": "array"
          },
          "abiOperationContracts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operation",
                "input",
                "expect"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "object"
                },
                "expect": {
                  "type": "object"
                }
              },
              "additionalProperties": true
            }
          },
          "runtimeBoundary": {
            "type": "object"
          },
          "optionalPlugins": {
            "type": "array"
          },
          "capabilities": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "providerId",
          "status",
          "ownerRepo",
          "advertisementPath",
          "surfaces",
          "commands",
          "surfaceContracts"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string",
            "minLength": 1
          },
          "advertisementPath": {
            "type": "string",
            "minLength": 1
          },
          "scenarioPath": {
            "type": "string"
          },
          "handoffPath": {
            "type": "string"
          },
          "handoffExportPath": {
            "type": "string"
          },
          "scenarioId": {
            "type": "string"
          },
          "receiptStates": {
            "type": "array"
          },
          "surfaces": {
            "type": "array"
          },
          "surfaceKinds": {
            "type": "array"
          },
          "surfaceContracts": {
            "type": "array"
          },
          "commands": {
            "type": "array"
          },
          "pluginRequirements": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runtimeId",
          "status",
          "ownerRepo",
          "splitTarget",
          "supportedFeatures",
          "supportedPlugins",
          "unsupportedPlugins",
          "captureStatus",
          "worldSurfaceLowering"
        ],
        "properties": {
          "runtimeId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string",
            "minLength": 1
          },
          "splitTarget": {
            "type": "string",
            "minLength": 1
          },
          "supportedFeatures": {
            "type": "array"
          },
          "supportedPlugins": {
            "type": "array"
          },
          "unsupportedPlugins": {
            "type": "array"
          },
          "capabilityManifestPath": {
            "type": "string"
          },
          "capabilityManifestErrors": {
            "type": "array"
          },
          "splitHandoffPath": {
            "type": "string"
          },
          "splitHandoffExportPath": {
            "type": "string"
          },
          "commandTransportSchema": {
            "type": "string"
          },
          "captureStatus": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "object"
          },
          "worldSurfaceLowering": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "splitTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ownerRepo",
          "repoRole",
          "status",
          "runtimes",
          "runtimeStatuses",
          "requiredRuntimeStatuses",
          "requiredFeatures",
          "requiredPlugins",
          "proofs",
          "pendingProofs",
          "blockers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string",
            "minLength": 1
          },
          "repoRole": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "declaredStatus": {
            "type": "string"
          },
          "runtimes": {
            "type": "array"
          },
          "runtimeStatuses": {
            "type": "object"
          },
          "requiredRuntimeStatuses": {
            "type": "array"
          },
          "requiredFeatures": {
            "type": "array"
          },
          "requiredPlugins": {
            "type": "array"
          },
          "proofs": {
            "type": "array"
          },
          "pendingProofs": {
            "type": "array"
          },
          "blockers": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
