{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamecult.eve.conformance_export.v1",
  "title": "Eve Conformance Export",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "sourceManifest",
    "packs",
    "plugins",
    "providers",
    "runtimes",
    "splitTargets"
  ],
  "properties": {
    "schema": {
      "const": "gamecult.eve.conformance_export.v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceManifest": {
      "type": "string",
      "minLength": 1
    },
    "boundaryRule": {
      "type": "string"
    },
    "incubationPolicy": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fixtures"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string"
          },
          "exitCriteria": {
            "type": "string"
          },
          "fixtures": {
            "type": "array"
          },
          "runtimeTargets": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "capabilityMatrix": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gamecult.eve.capability_matrix.v1"
        }
      },
      "additionalProperties": true
    },
    "capabilityGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "subjectId", "gap", "severity"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "worldSurfaceLoweringGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "providerId",
          "surfaceId",
          "targetId",
          "ownerRepo",
          "runtimeId",
          "severity"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "providerOwnerRepo": {
            "type": "string"
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1
          },
          "surfaceKind": {
            "type": "string"
          },
          "projectionKind": {
            "type": "string"
          },
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "ownerRepo": {
            "type": "string",
            "minLength": 1
          },
          "runtimeId": {
            "type": "string",
            "minLength": 1
          },
          "splitTarget": {
            "type": "string"
          },
          "runtimeStatus": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "plugins": {
      "type": "array"
    },
    "providers": {
      "type": "array"
    },
    "runtimes": {
      "type": "array"
    },
    "splitTargets": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
