{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamecult.eve.plugin_abi.request.v1",
  "title": "Eve Plugin ABI Request",
  "type": "object",
  "required": [
    "schema",
    "pluginId",
    "operation",
    "requestId",
    "input"
  ],
  "properties": {
