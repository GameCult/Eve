    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "targetRuntime": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
