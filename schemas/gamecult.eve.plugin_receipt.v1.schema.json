{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamecult.eve.plugin_receipt.v1",
  "title": "Eve Plugin Receipt",
  "type": "object",
  "required": [
    "schema",
    "receiptId",
    "pluginId",
    "operation",
    "state",
    "ownerRepo",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "gamecult.eve.plugin_receipt.v1"
    },
    "receiptId": {
      "type": "string",
      "minLength": 1
    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "denied",
        "pending",
        "reconciled",
        "diagnostic",
        "cached",
        "failed"
      ]
    },
    "ownerRepo": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string"
    },
    "stateEffects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "issuedAtUtc": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
